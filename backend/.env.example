# ==========================================
# Vision AI Backend Environment Variables
# ==========================================

# Database connection:
# - For local development: sqlite+aiosqlite:///./vision_ai.db
# - For Railway PostgreSQL: ${{Postgres.DATABASE_URL}} (Railway sets this automatically when you add a PostgreSQL plugin)
DATABASE_URL=sqlite+aiosqlite:///./vision_ai.db

# JWT Secret Key for authenticating users:
# Generate any secure random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=vision-ai-super-secret-key-production-change-me

# Google Gemini API Key for AI Insights & Market Analysis:
# Get one for free at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Google OAuth Client ID for User Login:
# (Should match the client ID in the frontend)
VITE_GOOGLE_CLIENT_ID=237727449322-dtb4vpup2fvvmopgg3dgb52btp7koi3a.apps.googleusercontent.com

# Google PageSpeed Insights API Key (optional):
# For technical SEO and Core Web Vitals audits
PAGESPEED_API_KEY=

# Firecrawl API Key (optional):
# For automated web crawling
FIRECRAWL_API_KEY=

# Port is automatically assigned by Railway (defaults to 8000 locally):
PORT=8000
